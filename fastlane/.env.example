# Copy to fastlane/.env and fill in. fastlane/.env is gitignored — this
# repository is public, so no real secret may ever be committed here.

# --- App Store Connect API key -------------------------------------------
# Users and Access > Integrations > App Store Connect API.
# The Issuer ID is shown once at the top of that page and is shared by all keys.
ASC_ISSUER_ID=
# Key ID of the key you use for uploads (needs App Manager or Admin access).
ASC_KEY_ID=
# Absolute path to the matching .p8 private key. Apple lets you download it
# once; keep it outside the repository, e.g. ~/.appstoreconnect/private_keys/.
ASC_KEY_FILEPATH=~/.appstoreconnect/private_keys/AuthKey_<KEY_ID>.p8

# --- Identifiers (defaults are already correct; override only if they change)
# IOS_BUNDLE_ID=com.obligio.app
# ANDROID_PACKAGE_NAME=com.obligio.app
# APPLE_TEAM_ID=2KBXMW6U9N
# ASC_APP_ID=6808265621

# --- Google Play ----------------------------------------------------------
# Play Console > Setup > API access: create a service account, grant it
# "Release manager", download its JSON key, and keep it outside the repository.
PLAY_JSON_KEY_FILE=
# internal | alpha | beta | production
PLAY_TRACK=internal
# draft keeps the release un-promoted until you review it in the console.
PLAY_RELEASE_STATUS=draft

# --- Build ----------------------------------------------------------------
# Defaults to a UTC timestamp when unset.
# BUILD_NUMBER=
