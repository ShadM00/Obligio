default_platform(:ios)

# Authentication uses an App Store Connect API key rather than an Apple ID and
# password: it is 2FA-proof and non-interactive. The .p8 stays outside the
# repository — point ASC_KEY_FILEPATH at it. See fastlane/.env.example.
def app_store_connect_api_key!
  app_store_connect_api_key(
    key_id: ENV.fetch('ASC_KEY_ID'),
    issuer_id: ENV.fetch('ASC_ISSUER_ID'),
    key_filepath: File.expand_path(ENV.fetch('ASC_KEY_FILEPATH')),
    in_house: false,
  )
end

platform :ios do
  desc 'Build a signed App Store archive and upload it to TestFlight'
  lane :release do
    api_key = app_store_connect_api_key!

    increment_build_number(
      xcodeproj: 'ios/ComplianceCalendar.xcodeproj',
      build_number: ENV.fetch('BUILD_NUMBER', Time.now.strftime('%Y%m%d%H%M')),
    )

    build_app(
      workspace: 'ios/ComplianceCalendar.xcworkspace',
      scheme: 'ComplianceCalendar',
      configuration: 'Release',
      export_method: 'app-store',
      output_directory: 'build/ios',
      clean: true,
      # The project uses automatic signing and no distribution profile exists
      # for com.obligio.app yet, so Xcode has to create one.
      #
      # exportArchive authenticates separately from the archive step, and this
      # machine has no Apple account signed into Xcode — without the key
      # arguments below it fails with "No Accounts" and "No profiles for
      # com.obligio.app were found" even though the archive itself succeeded.
      xcargs: '-allowProvisioningUpdates',
      export_xcargs: "-allowProvisioningUpdates " \
                     "-authenticationKeyPath #{File.expand_path(ENV.fetch('ASC_KEY_FILEPATH'))} " \
                     "-authenticationKeyID #{ENV.fetch('ASC_KEY_ID')} " \
                     "-authenticationKeyIssuerID #{ENV.fetch('ASC_ISSUER_ID')}",
      export_options: {
        signingStyle: 'automatic',
      },
    )

    # TestFlight, not App Store submission. upload_to_app_store (deliver) is
    # for pushing a listing, and does not accept
    # skip_waiting_for_build_processing; that belongs to this action. Listing
    # metadata is pushed deliberately by the `metadata` lane instead.
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
    )
  end

  desc 'Upload an already-built IPA to TestFlight, without rebuilding'
  lane :upload do
    # Apple's transporter fails with a bare "A server error occurred.
    # (-19241)" often enough that rebuilding just to retry the upload is
    # wasted time. This reuses the artefact build_app already produced.
    # Anchored to the repository root via __dir__ (the fastlane/ directory):
    # a lane's working directory is fastlane/, not the project root, so a bare
    # relative path resolves to the wrong place.
    default_ipa = File.expand_path('../build/ios/ComplianceCalendar.ipa', __dir__)
    ipa = ENV.fetch('IPA_PATH', default_ipa)
    UI.user_error!("No IPA at #{ipa}. Run `fastlane ios release` first.") unless File.exist?(ipa)

    upload_to_testflight(
      api_key: app_store_connect_api_key!,
      ipa: ipa,
      skip_waiting_for_build_processing: true,
    )
  end

  desc 'Push App Store listing metadata from fastlane/metadata without uploading a build'
  lane :metadata do
    upload_to_app_store(
      api_key: app_store_connect_api_key!,
      skip_binary_upload: true,
      # Screenshots live in fastlane/screenshots/<locale>, built by
      # scripts/capture-screenshots.py and scripts/build-store-screenshots.py.
      # Overwriting is what makes a re-push replace the set rather than
      # append to it.
      skip_screenshots: true,
      precheck_include_in_app_purchases: false,
      # Skips deliver's interactive "does this preview look okay?" step. The
      # metadata under fastlane/metadata is the reviewed artefact.
      force: true,
    )
  end

  desc 'Push App Store screenshots from fastlane/screenshots without uploading a build'
  lane :screenshots do
    # Separate from `metadata` on purpose. Uploading text for an app whose
    # first version has never been submitted ends in spaceship raising
    # "No data" -- after the text has landed, but before deliver reaches the
    # screenshots. Run on its own, the screenshot upload never touches that
    # path.
    #
    # deliver only knows iPhone sizes up to 6.7" (1290x2796) and rejects
    # 1320x2868 as an invalid screen size, so that is what
    # scripts/build-store-screenshots.py composes. Apple accepts it for the
    # 6.9" slot.
    upload_to_app_store(
      api_key: app_store_connect_api_key!,
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: false,
      overwrite_screenshots: true,
      precheck_include_in_app_purchases: false,
      force: true,
    )
  end
end

platform :android do
  desc 'Build a signed Android App Bundle and upload it to the chosen Play track'
  lane :release do
    gradle(task: 'clean', project_dir: 'android')
    # `bundleRelease` is the release *build type*. An earlier version passed
    # `flavor: 'Release'`, which Gradle resolves as a product flavour — this
    # project has none, so that task never existed.
    gradle(task: 'bundleRelease', project_dir: 'android')

    upload_to_play_store(
      track: ENV.fetch('PLAY_TRACK', 'internal'),
      aab: 'android/app/build/outputs/bundle/release/app-release.aab',
      release_status: ENV.fetch('PLAY_RELEASE_STATUS', 'draft'),
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
  end

  desc 'Push Play listing metadata from fastlane/metadata/android without uploading a build'
  lane :metadata do
    # supply resolves a track even for a listing-only upload, so name one --
    # the default is production, which has no release, and it dies on the nil
    # release with "undefined method `size' for nil".
    #
    # Changelogs are release notes: they are keyed by version code and belong
    # with the build, so `android release` carries them. Pushing them from here
    # would need a version code this lane has no business knowing.
    upload_to_play_store(
      track: ENV.fetch('PLAY_TRACK', 'internal'),
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_changelogs: true,
    )
  end
end
